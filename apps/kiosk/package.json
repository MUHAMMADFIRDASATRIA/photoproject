{
  "name": "@photobox/kiosk",
  "version": "1.0.0",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron electron/dev-bootstrap.cjs",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "package": "electron-builder"
  },
  "build": {
    "appId": "com.photobox.kiosk",
    "productName": "Photobox Kiosk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/pdf-to-printer/dist/**"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@photobox/shared": "*",
    "axios": "^1.7.0",
    "pdf-to-printer": "^5.6.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vite": "^6.3.0"
  }
}
