// Photobox API Cloud — Backend cloud untuk Web Dashboard
// Sesuai CLAUDE.md: Supabase/Neon PostgreSQL + Cloud Storage

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/photobox_cloud"
// WAJIB BEDA dari JWT_SECRET di api-local (trust domain berbeda)
JWT_SECRET="set ke nilai random unik service ini"
PORT=4001

// Password akun awal saat `prisma db seed` — wajib di-set di production
// SEED_PASSWORD=""

// Sync catalog machine-to-machine — petakan tiap kunci ke branchId yang boleh
// ditarik mesin kiosk. "*" = semua cabang (hanya untuk operator trust penuh).
// SYNC_API_KEYS='{"<kunci-mesin-a>":"1","<kunci-mesin-b>":"1"}'

// Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="photobox-photos"
R2_PUBLIC_URL=""