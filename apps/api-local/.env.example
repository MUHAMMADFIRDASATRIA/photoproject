// Photobox API Local — Backend kiosk lokal
// Sesuai CLAUDE.md: PostgreSQL lokal, offline-resilient

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/photobox_local"
// WAJIB BEDA dari JWT_SECRET di api-cloud (trust domain berbeda)
JWT_SECRET="set ke nilai random unik service ini"
PORT=4000

// Secret HMAC link QR unduhan foto — wajib stabil di production
DOWNLOAD_SECRET="set ke random string panjang"

// Password akun device saat seed
// SEED_PASSWORD=""

// Sinkronisasi katalog dari cloud
CLOUD_API_URL="http://localhost:4001"
// CLOUD_API_KEY harus match salah satu kunci di SYNC_API_KEYS (cloud), per mesin
// CLOUD_API_KEY=""

// URL publik QR download saat kiosk memakai domain/HTTPS
// PUBLIC_URL="https://foto.photobox.id"